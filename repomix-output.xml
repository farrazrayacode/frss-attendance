                "password": password,
                "role_id": role_id
            })
            
            return json.dumps({
                "status": "success",
                "message": "User registered successfully"
            })
            
        except Exception as e:
            return json.dumps({"status": "error", "message": f"Registration failed: {str(e)}"})
            
