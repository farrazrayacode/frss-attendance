user_id SERIAL PRIMARY KEY,​
name TEXT NOT NULL,​
role TEXT CHECK (role IN ('Employee', 'VIP', 'Blacklisted')),​
status TEXT CHECK (status IN ('Active', 'Inactive')),​
created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP​
);​
​
-- Faces Table (Stores embeddings for recognition)​
CREATE TABLE faces (​
face_id SERIAL PRIMARY KEY,​
user_id INTEGER REFERENCES users(user_id) ON DELETE CASCADE,​
embedding vector(512), -- 512-dimensional face embedding​
registered_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP​
);​
​
-- Cameras Table (Stores CCTV RTSP sources)​
CREATE TABLE cameras (​
camera_id SERIAL PRIMARY KEY,​
location TEXT NOT NULL,​
rtsp_url TEXT UNIQUE NOT NULL,​
active BOOLEAN DEFAULT TRUE​
);​
​
-- Attendance Table (Logs recognized attendance)​

CREATE TABLE attendance (​
attendance_id SERIAL PRIMARY KEY,​
user_id INTEGER REFERENCES users(user_id) ON DELETE CASCADE,​
camera_id INTEGER REFERENCES cameras(camera_id) ON DELETE CASCADE,​
timestamp TIMESTAMP DEFAULT CURRENT_TIMESTAMP,​
status TEXT CHECK (status IN ('Present', 'Late', 'Absent'))​
);​
​
-- Alerts Table (Logs blacklist detections, intrusions, and security
events)​
CREATE TABLE alerts (​
alert_id SERIAL PRIMARY KEY,​
user_id INTEGER REFERENCES users(user_id) ON DELETE CASCADE,​
camera_id INTEGER REFERENCES cameras(camera_id) ON DELETE CASCADE,​
alert_type TEXT CHECK (alert_type IN ('Blacklist Detected',
'Unauthorized Entry', 'Unusual Behavior')),​
timestamp TIMESTAMP DEFAULT CURRENT_TIMESTAMP​
);​
​
-- Motion Detection Table (Logs motion events for objects, people,
vehicles)​
CREATE TABLE motion_events (​
event_id SERIAL PRIMARY KEY,​
camera_id INTEGER REFERENCES cameras(camera_id) ON DELETE CASCADE,​
timestamp TIMESTAMP DEFAULT CURRENT_TIMESTAMP,​
event_type TEXT CHECK (event_type IN ('Person', 'Vehicle', 'Object')),​
image_path TEXT​
);​
​
-- Unattended Object Table (Logs unattended objects detection)​
CREATE TABLE unattended_objects (​
obj_id SERIAL PRIMARY KEY,​
camera_id INTEGER REFERENCES cameras(camera_id) ON DELETE CASCADE,​
timestamp TIMESTAMP DEFAULT CURRENT_TIMESTAMP,​
obj_type TEXT CHECK (obj_type IN ('Bag', 'Box', 'Other')),​
image_path TEXT​
);​
​
-- Vehicle Detection Table (Logs vehicle recognition and license plate
detection)​
CREATE TABLE vehicles (​
vehicle_id SERIAL PRIMARY KEY,​
camera_id INTEGER REFERENCES cameras(camera_id) ON DELETE CASCADE,​

timestamp TIMESTAMP DEFAULT CURRENT_TIMESTAMP,​
plate_number TEXT UNIQUE,​
vehicle_type TEXT CHECK (vehicle_type IN ('Car', 'Truck',
'Motorcycle')),​
image_path TEXT​
);​
​
-- Video and Image Storage Table (Stores evidence of security events)​
CREATE TABLE video_storage (​
video_id SERIAL PRIMARY KEY,​
camera_id INTEGER REFERENCES cameras(camera_id) ON DELETE CASCADE,​
detected_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,​
video_path TEXT,​
image_path TEXT​
);​
​
-- Notifications Table (Sends real-time security alerts)​
CREATE TABLE notifications (​
notif_id SERIAL PRIMARY KEY,​
user_id INTEGER REFERENCES users(user_id) ON DELETE CASCADE,​
alert_id INTEGER REFERENCES alerts(alert_id) ON DELETE CASCADE,​
message TEXT,​
sent_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP​
);

