): Promise<User[]> => {
    await verifyJWT(
        accessToken,
        JWT_ACCESS_TOKEN_SECRET as string,
    );

    const users = await repo.getAllUsers(search, roleFilter, statusFilter, approvalFilter);
    return users;
};

