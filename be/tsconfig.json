{
  "compilerOptions": {
    "target": "es6",
    "module": "commonjs",
    "outDir": "./dist",
    "rootDir": "./src",
    "paths": {
      "@/*": ["./src/*"],
      "@routes/*": ["./src/routes/*"],
      "@database/*": ["./src/database/*"],
      "@utils/*": ["./src/utils/*"],
      "@types/*": ["./src/types/*"],
      "@modules/*": ["./src/modules/*"],
      "@config/*": ["./src/config/*"],
      "@middlewares/*": ["./src/middlewares/*"],
      "@interfaces/*": ["./src/interfaces/*"]
    },
    "esModuleInterop": true,
    "typeRoots": ["node_modules/@types"],
    "types": ["node", "jest"],
    "strict": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "lib": ["esnext", "dom"]
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "src/tests/**",
    "src/**/*.test.ts",
    "src/**/*.spec.ts"
  ]
}